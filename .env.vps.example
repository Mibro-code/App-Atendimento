POSTGRES_DB=app_whats
POSTGRES_USER=app_whats
POSTGRES_PASSWORD=SENHA_FORTE_SEM_CARACTERES_DE_URL
SESSION_SECRET=CHAVE_ALEATORIA_COM_PELO_MENOS_32_CARACTERES
VERIFY_TOKEN=TOKEN_DE_VERIFICACAO_DO_WEBHOOK
WHATSAPP_TOKEN=TOKEN_DA_WHATSAPP_CLOUD_API
PHONE_NUMBER_ID=ID_DO_NUMERO_META
WHATSAPP_BUSINESS_ACCOUNT_ID=ID_DA_CONTA_WHATSAPP_BUSINESS
GRAPH_VERSION=vXX.X
META_APP_SECRET=APP_SECRET_DA_META
INTEGRATION_API_SECRET=CHAVE_ALEATORIA_COM_PELO_MENOS_32_CARACTERES

# Opcional: motor de interpretação de Bots (Fase 2). Sem ANTHROPIC_API_KEY a
# aplicação inicia normalmente e usa apenas o LocalFallbackProvider (regras +
# similaridade tolerante a erros de digitação). Nunca commitar a chave real.
# ANTHROPIC_API_KEY=CHAVE_DA_API_ANTHROPIC
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_TIMEOUT_MS=8000

# Opcional: arquitetura omnichannel (Email, Mercado Livre, TikTok Shop,
# Amazon, Shopee, Google Reviews, Reclame Aqui). Sem INTEGRATION_ENCRYPTION_KEY
# a aplicação inicia normalmente com todo canal novo desativado — só as
# operações de salvar/ler credencial de integração exigem a chave. O
# WhatsApp/Meta (WHATSAPP_TOKEN acima) nunca depende de nada desta seção.
# INTEGRATION_ENCRYPTION_KEY=CHAVE_DE_32_BYTES_EM_HEX_OU_BASE64

# Credenciais de app OAuth por provider — cada uma é opcional e só é
# necessária quando aquele canal específico for configurado pelo painel de
# Integrações (Master). Nunca commitar valores reais.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://SEU_DOMINIO/api/integrations/oauth/callback
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_REDIRECT_URI=https://SEU_DOMINIO/api/integrations/oauth/callback
# MERCADO_LIVRE_CLIENT_ID=
# MERCADO_LIVRE_CLIENT_SECRET=
# MERCADO_LIVRE_OAUTH_REDIRECT_URI=https://SEU_DOMINIO/api/integrations/oauth/callback
