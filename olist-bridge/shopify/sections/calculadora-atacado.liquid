        registered_address_fields: {
          street: formData.cadastro_logradouro || '',
          number: formData.cadastro_numero || '',
          complement: formData.cadastro_complemento || '',
          district: formData.cadastro_bairro || '',
          city: formData.cadastro_cidade || '',
          state: formData.cadastro_uf || '',
          zip: formData.cadastro_cep || '',
          country: 'Brasil'
        },
        shipping_address_fields:
          form.elements.endereco_correto.value === 'sim'
            ? null
            : {
                street: formData.entrega_logradouro || '',
                number: formData.entrega_numero || '',
                complement: formData.entrega_complemento || '',
                district: formData.entrega_bairro || '',
                city: formData.entrega_cidade || '',
