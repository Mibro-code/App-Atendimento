        setStep(3);
        showMessage(
          summaryEmailSaved ? 'success' : 'error',
          summaryEmailSaved
            ? 'Cadastro conclu\u00eddo. Resumo do pedido e imagem enviados ao e-mail da loja.'
            : 'Cadastro conclu\u00eddo e resumo calculado, mas o e-mail com a imagem n\u00e3o foi enviado.'
        );
      } catch (error) {
        state.flow = 'registration_after_simulation';
        console.error(error);
        showMessage('error', error?.message || 'N\u00e3o foi poss\u00edvel calcular os valores na Olist.');
      }
    });

    root.querySelector('[data-prev-step]').addEventListener('click', () => setStep(state.flow === 'simulation' ? 0 : 1));

    root.querySelector('[data-go-summary]').addEventListener('click', async (event) => {
      const selectionError = wholesaleSelectionError();
      if (selectionError) {
        showMessage('error', selectionError);
        return;
      }

      const button = event.currentTarget;
      const originalText = button.textContent;
      button.disabled = true;
      button.textContent = state.flow === 'simulation' ? 'Preparando simula\u00e7\u00e3o...' : state.testMode
        ? 'Preparando prévia de teste...'
        : 'Calculando no Olist...';

      try {
        calculateDiscount();
        renderSummary();

        if (state.flow === 'simulation') {
          renderSimulationPreview();
        } else if (state.testMode) {
          renderTestPreview();
        } else {
          await calculateWithOlist();
          renderOlistValues(state.olistValues);
        }

        setStep(3);
      } catch (error) {
        console.error(error);
        showMessage('error', error?.message || 'Não foi possível calcular os valores no Olist.');
      } finally {
        button.disabled = false;
        button.textContent = originalText;
      }
