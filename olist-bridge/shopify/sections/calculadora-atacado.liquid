    const canvasFitText = (context, value, maxWidth) => {
      const text = String(value || '');
      if (context.measureText(text).width <= maxWidth) return text;
      let shortened = text;
      while (shortened.length > 1 && context.measureText(`${shortened}…`).width > maxWidth) {
        shortened = shortened.slice(0, -1);
      }
      return `${shortened}…`;
    };

    const canvasWrappedText = (context, value, x, y, maxWidth, lineHeight, maxLines = 3) => {
      const words = String(value || '').split(/\s+/).filter(Boolean);
      const lines = [];
      let current = '';

      words.forEach((word) => {
        const candidate = current ? `${current} ${word}` : word;
        if (context.measureText(candidate).width <= maxWidth || !current) {
          current = candidate;
        } else {
          lines.push(current);
          current = word;
        }
      });
      if (current) lines.push(current);

      lines.slice(0, maxLines).forEach((line, index) => {
        const isLast = index === maxLines - 1 && lines.length > maxLines;
        context.fillText(
          isLast ? canvasFitText(context, `${line}…`, maxWidth) : line,
          x,
          y + index * lineHeight
        );
      });

      return y + Math.min(lines.length, maxLines) * lineHeight;
    };

    const createProposalA4Image = (proposal, eventType) => {
      const canvas = document.createElement('canvas');
      canvas.width = 1240;
      canvas.height = 1754;
      const context = canvas.getContext('2d');
      const pageWidth = canvas.width;
      const margin = 78;
      const contentWidth = pageWidth - margin * 2;
      const ink = '#1F1F1F';
      const muted = '#637083';
      const primary = '#FF6633';
      const border = '#FFD5C7';
      const pale = '#FFF7F3';

      context.fillStyle = '#ffffff';
      context.fillRect(0, 0, canvas.width, canvas.height);
      context.fillStyle = primary;
      context.fillRect(0, 0, canvas.width, 224);
      context.fillStyle = '#ffffff';
      context.font = '700 22px Arial, sans-serif';
      context.fillText('MIBRO · CONDIÇÃO COMERCIAL', margin, 72);
      context.font = '700 48px Arial, sans-serif';
      context.fillText(
        eventType === 'olist_confirmed' ? 'Pedido enviado ao Olist' : 'Resumo da proposta',
        margin,
        145
      );
      context.font = '400 22px Arial, sans-serif';
      context.fillText(new Date().toLocaleString('pt-BR'), margin, 188);

      let y = 282;
      context.fillStyle = ink;
      context.font = '700 27px Arial, sans-serif';
      context.fillText('Dados comerciais', margin, y);
      y += 34;
      context.strokeStyle = border;
      context.lineWidth = 2;
      context.strokeRect(margin, y, contentWidth, 210);

      const leftX = margin + 24;
      const rightX = margin + contentWidth / 2 + 24;
      const valueWidth = contentWidth / 2 - 48;
      const drawField = (label, value, x, fieldY) => {
        context.fillStyle = muted;
        context.font = '700 16px Arial, sans-serif';
        context.fillText(label.toUpperCase(), x, fieldY);
        context.fillStyle = ink;
        context.font = '400 21px Arial, sans-serif';
        context.fillText(canvasFitText(context, value || 'Não informado', valueWidth), x, fieldY + 29);
      };

      drawField('Empresa', proposal.company_name, leftX, y + 38);
      drawField('CNPJ', formatCnpj(proposal.cnpj), rightX, y + 38);
      drawField('Comprador', proposal.buyer, leftX, y + 108);
      drawField('Vendedor', proposal.seller, rightX, y + 108);
      drawField('Telefone', proposal.phone, leftX, y + 178);
      drawField('E-mail', proposal.email, rightX, y + 178);
      y += 270;
      context.fillStyle = ink;
      context.font = '700 27px Arial, sans-serif';
      context.fillText('Produtos selecionados', margin, y);
      y += 28;
      context.fillStyle = pale;
      context.fillRect(margin, y, contentWidth, 54);
      context.fillStyle = ink;
      context.font = '700 16px Arial, sans-serif';
      context.fillText('PRODUTO', margin + 18, y + 34);
      context.fillText('QTD.', margin + 620, y + 34);
      context.fillText('UNITÁRIO', margin + 760, y + 34);
      context.fillText('SUBTOTAL', margin + 940, y + 34);
      y += 54;

      proposal.products.forEach((product) => {
        context.strokeStyle = border;
        context.strokeRect(margin, y, contentWidth, 70);
        context.fillStyle = ink;
        context.font = '700 18px Arial, sans-serif';
        context.fillText(canvasFitText(context, product.name, 500), margin + 18, y + 41);
        context.fillStyle = ink;
        context.font = '400 18px Arial, sans-serif';
        context.fillText(String(product.quantity), margin + 635, y + 40);
        context.fillText(money(product.unit_price_cents), margin + 760, y + 40);
        context.font = '700 18px Arial, sans-serif';
        context.fillText(money(product.subtotal_cents), margin + 940, y + 40);
        y += 70;
      });

      y += 34;
      const totalsX = margin + 600;
      const totalsValueX = margin + contentWidth;
      const drawTotal = (label, value, strong = false) => {
        context.fillStyle = strong ? ink : muted;
        context.font = `${strong ? '700 24px' : '400 19px'} Arial, sans-serif`;
        context.textAlign = 'left';
        context.fillText(label, totalsX, y);
        context.textAlign = 'right';
        context.fillStyle = strong ? primary : ink;
        context.fillText(value, totalsValueX, y);
        context.textAlign = 'left';
        y += strong ? 42 : 34;
      };
      drawTotal('Quantidade total', String(proposal.total_quantity));
      drawTotal('Subtotal', money(proposal.subtotal_cents));
      drawTotal('Desconto', `− ${money(proposal.discount_cents)}`);
      drawTotal(proposal.simulation_only ? 'Total dos produtos' : 'Total comercial', money(proposal.commercial_total_cents), true);
      if (proposal.olist_total_cents) {
        drawTotal('Total Olist', money(proposal.olist_total_cents), true);
      }

      y = Math.max(y + 20, 1430);
      context.fillStyle = ink;
      context.font = '700 22px Arial, sans-serif';
      context.fillText('Endereço de entrega', margin, y);
      context.fillStyle = muted;
      context.font = '400 18px Arial, sans-serif';
      canvasWrappedText(context, proposal.shipping_address, margin, y + 32, contentWidth, 25, 3);

      context.fillStyle = pale;
      context.fillRect(0, 1658, pageWidth, 96);
      context.fillStyle = muted;
      context.font = '400 16px Arial, sans-serif';
      context.fillText('Documento gerado automaticamente pela área de atacado Mibro.', margin, 1700);
      context.fillText(`Cotação: ${proposal.quote_token}`, margin, 1728);

      return canvas.toDataURL('image/jpeg', 0.84);
    };

    const sendProposalEmail = async (proposal, eventType) => {
      if (!config.emailEndpoint) {
        throw new Error('Configure o endpoint de e-mail da proposta.');
      }

      const a4Image = createProposalA4Image(proposal, eventType);
      const response = await fetch(config.emailEndpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          event: eventType,
          proposal,
          olist_order_id: proposal.olist_order_id || '',
          a4_image: a4Image,
          send_to_customer: proposal.simulation_only === true
        })
      });
      const rawText = await response.text();
      let result = {};
      try { result = rawText ? JSON.parse(rawText) : {}; } catch (_) {}

      if (!response.ok || result.success === false) {
        throw new Error(result.message || result.error || `Falha HTTP ${response.status}.`);
      }
      return result;
    };
    const saveProposal = async () => {
      const simulation = state.flow === 'simulation';
      if (simulation) {
        const email = String(form.elements.simulation_email.value || '').trim();
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          form.elements.simulation_email.focus();
          showMessage('error', 'Informe um e-mail v\u00e1lido para receber a proposta.');
          return;
        }
        form.elements.email.value = email;
      }
      if (!simulation && !state.testMode && !state.olistCalculated) {
        showMessage('error', 'Calcule os valores no Olist antes de confirmar a proposta.');
        return;
      }
      const selectionError = wholesaleSelectionError();
      if (selectionError) {
        showMessage('error', selectionError);
        return;
      }

      const button = root.querySelector('[data-save-proposal]');
      const payload = proposalPayload();
      localStorage.setItem(
        `atacado_proposta_${config.brandName || config.storeName}`,
        JSON.stringify(payload)
      );

      button.disabled = true;
      const originalText = button.textContent;
      button.textContent = 'Gerando formulário A4...';

      try {
        await sendProposalEmail(payload, 'proposal');
        showMessage(
          'success',
          'Proposta enviada por e-mail com o formulário e a imagem A4 anexada.'
        );
      } catch (error) {
        console.error(error);
        showMessage(
          'error',
          error?.message || 'Não foi possível enviar a proposta por e-mail. Ela continua salva neste navegador.'
        );
      } finally {
        button.disabled = false;
        button.textContent = originalText;
      }
    };

    const saveFinalizedContact = async (proposal) => {
      return sendProposalEmail(proposal, 'olist_confirmed');
    };
    const confirmOlistOrder = async () => {
      if (!state.modeLoaded || state.modeError || state.testMode) {
        showMessage(
          'error',
          'A criação de pedidos está bloqueada. Desative o modo teste no painel do app Shopify.'
        );
        return;
      }

      if (!state.olistCalculated || !state.olistOrderId) {
        showMessage('error', 'Calcule o pedido no Olist antes de confirmar.');
        return;
      }

      const selectionError = wholesaleSelectionError();
      if (selectionError) {
        showMessage('error', selectionError);
        return;
      }

      const button = root.querySelector('[data-confirm-order]');
      const originalText = button.textContent;
      const payload = {
        olist_order_id: state.olistOrderId,
        action: 'confirm_for_approval',
        request_payment_after_approval: true,
        proposal: proposalPayload()
      };

      localStorage.setItem(
        `atacado_proposta_${config.brandName || config.storeName}`,
        JSON.stringify(payload)
      );

      if (!config.confirmEndpoint) {
        showMessage('success', 'Pedido calculado e salvo neste navegador. Configure o endpoint de confirmação para enviá-lo à aprovação no Olist.');
        return;
      }

      button.disabled = true;
      button.textContent = 'Enviando pedido pendente...';

      try {
        const response = await fetch(config.confirmEndpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload)
        });

        const rawText = await response.text();
        let result = {};
        try { result = rawText ? JSON.parse(rawText) : {}; } catch (_) {}

        if (!response.ok || result.success === false) {
          throw new Error(result.message || result.error || `Falha HTTP ${response.status}.`);
        }

        state.olistConfirmed = true;
        let contactMessage =
          ' Os dados do contato também foram enviados ao e-mail da loja.';

        try {
          await saveFinalizedContact(proposalPayload());
        } catch (contactError) {
          console.error(contactError);
          contactMessage =
            ' O pedido foi confirmado, mas o formulário de contato não pôde ser enviado.';
        }

        try {
          sessionStorage.removeItem(quoteStorageKey);
        } catch (_) {}

        showMessage(
          'success',
          (result.message ||
            'Pedido mantido em aberto no Olist e enviado para análise da responsável.') +
            contactMessage
        );
        syncWholesaleModeUi();
      } catch (error) {
        console.error(error);
        showMessage('error', error?.message || 'Não foi possível confirmar o pedido no Olist.');
      } finally {
        button.textContent = originalText;
        syncWholesaleModeUi();
      }
    };

