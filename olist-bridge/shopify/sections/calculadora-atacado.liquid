    root.querySelector('[data-next-step]').addEventListener('click', async () => {
      if (!validateStepOne()) return;
      if (!state.resumeSummaryAfterRegistration) { setStep(2); return; }
      try {
        calculateDiscount();
        renderSummary();
        state.flow = 'registration';
        if (state.testMode) renderTestPreview();
        else { await calculateWithOlist(); renderOlistValues(state.olistValues); }
        state.resumeSummaryAfterRegistration = false;
        let summaryEmailSaved = false;
        try {
          await sendProposalEmail(proposalPayload(), 'proposal');
          summaryEmailSaved = true;
        } catch (emailError) {
          console.error('Falha ao salvar o resumo pos-cadastro por e-mail.', emailError);
