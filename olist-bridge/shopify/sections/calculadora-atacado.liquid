    root.querySelector('[data-continue-registration]').addEventListener('click', () => {
      const simulationEmail = String(form.elements.simulation_email.value || '').trim();
      if (simulationEmail) form.elements.email.value = simulationEmail;
      state.flow = 'registration_after_simulation';
      state.resumeSummaryAfterRegistration = true;
      const emailCard = root.querySelector('[data-email-card]');
      emailCard.hidden = Boolean(form.elements.email.value);
      form.elements.email.required = !form.elements.email.value;
      setStep(1);
    });

    const invalidateOlistCalculation = () => {
      state.olistCalculated = false;
      state.olistValues = null;
      state.olistConfirmed = false;
      calculateDiscount();

      if (state.flow === 'simulation') {
        renderSummary();
        renderSimulationPreview();
        return;
      }
      if (state.testMode) {
        renderSummary();
        renderTestPreview();
        return;
      }

      root.querySelector('[data-olist-message]').textContent =
        'A condição comercial foi alterada. Clique em “Atualizar total no Olist”.';
      root.querySelector('[data-olist-total-sent]').textContent = '—';
      root.querySelector('[data-tax-breakdown-details]').hidden = true;
      root.querySelector('[data-tax-breakdown-unavailable]').hidden = true;
      root.querySelector('[data-olist-ipi]').textContent = '—';
      root.querySelector('[data-olist-icms]').textContent = '—';
      root.querySelector('[data-olist-st]').textContent = '—';
      root.querySelector('[data-olist-other]').textContent = '—';
      root.querySelector('[data-olist-tax-total]').textContent = '—';
      root.querySelector('[data-summary-total]').textContent = '—';
      root.querySelector('[data-confirm-order]').disabled = true;
      root.querySelector('[data-save-proposal]').disabled = true;

      const status = root.querySelector('[data-recalculate-status]');
      status.classList.remove('is-success');
      status.classList.add('is-stale');
      status.textContent = 'Desconto ou cupom alterado. O total precisa ser atualizado no Olist.';
    };

    const recalculateOlistValues = async (event) => {
      const selectionError = wholesaleSelectionError();
      if (selectionError) {
        showMessage('error', selectionError);
        return;
      }

      const button = event.currentTarget;
      const originalText = button.textContent;
      button.disabled = true;
      button.textContent = state.testMode
        ? 'Atualizando prévia de teste...'
        : 'Atualizando no Olist...';

      try {
        calculateDiscount();
        renderSummary();

        if (state.testMode) {
          renderTestPreview();
          showMessage('success', 'Prévia comercial de teste atualizada sem criar pedido.');
        } else {
          await calculateWithOlist();
          renderOlistValues(state.olistValues);
          showMessage('success', 'Total atualizado e confirmado pelo Olist.');
        }
      } catch (error) {
        console.error(error);
        invalidateOlistCalculation();
        showMessage('error', error?.message || 'Não foi possível atualizar os valores no Olist.');
      } finally {
        button.disabled = false;
        button.textContent = originalText;
      }
    };

    root.querySelector('[data-discount-type]').addEventListener('change', () => {
      calculateDiscount();
      invalidateOlistCalculation();
    });
    root.querySelector('[data-discount-value]').addEventListener('input', invalidateOlistCalculation);
    root.querySelector('[data-coupon-code]').addEventListener('input', invalidateOlistCalculation);
    root.querySelector('[data-recalculate-olist]').addEventListener('click', recalculateOlistValues);

    root.querySelector('[data-save-proposal]').addEventListener('click', saveProposal);
    root.querySelector('[data-confirm-order]').addEventListener('click', confirmOlistOrder);

    calculate();
    loadWholesaleMode();
  })();
</script>

