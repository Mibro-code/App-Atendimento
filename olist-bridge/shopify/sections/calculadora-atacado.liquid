</style>

<script>
  (() => {
    const root = document.getElementById('Atacado-{{ section.id }}');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const form = root.querySelector('[data-atacado-form]');
    const config = JSON.parse(root.querySelector('[data-atacado-config]').textContent);
    const rows = [...root.querySelectorAll('[data-product-row]')];
    const mobileCards = [...root.querySelectorAll('[data-mobile-product]')];
    const quoteStorageKey = `mibro_atacado_quote_{{ section.id }}`;

    const getOrCreateQuoteToken = () => {
      try {
        const existing = sessionStorage.getItem(quoteStorageKey);
        if (/^[a-zA-Z0-9_-]{16,100}$/.test(existing || '')) return existing;

        const bytes = new Uint8Array(24);
        crypto.getRandomValues(bytes);
        const token = [...bytes]
          .map((value) => value.toString(16).padStart(2, '0'))
          .join('');
        sessionStorage.setItem(quoteStorageKey, token);
        return token;
      } catch (_) {
        return `${Date.now()}_${Math.random().toString(36).slice(2)}_${Math.random().toString(36).slice(2)}`;
      }
    };

    const state = {
      quoteToken: getOrCreateQuoteToken(),
      currentStep: 0,
      flow: 'choice',
      resumeSummaryAfterRegistration: false,
      products: rows.map((row) => ({
        id: row.dataset.productId,
        modelId: row.dataset.modelId || row.dataset.productId,
        name: row.dataset.productName,
        sku: row.dataset.productSku || '',
        shopifyProductId: row.dataset.shopifyProductId || '',
        shopifyVariantId: row.dataset.shopifyVariantId || '',
        linked: row.dataset.productLinked === 'true',
        retail: Number(row.dataset.priceRetail || 0),
        tier1: Number(row.dataset.priceTier1 || 0),
        tier2: Number(row.dataset.priceTier2 || 0),
        tier3: Number(row.dataset.priceTier3 || 0),
        qty: 0,
        unitPrice: 0,
        subtotal: 0
      })),
      subtotal: 0,
      discount: 0,
      total: 0,
      totalQty: 0,
      tier: 'retail',
      pricingMode: 'mixed',
      pricingVerified: false,
      olistOrderId: '',
      olistCalculated: false,
      olistValues: null,
      olistConfirmed: false,
      testMode: true,
      modeLoaded: false,
      modeError: false
    };

    const startNewQuote = () => {
      try {
        sessionStorage.removeItem(quoteStorageKey);
      } catch (_) {}

      state.quoteToken = getOrCreateQuoteToken();
      state.olistOrderId = '';
      state.olistCalculated = false;
      state.olistValues = null;
      state.olistConfirmed = false;
    };

    const money = (cents) => {
      return new Intl.NumberFormat(config.locale || 'pt-BR', {
        style: 'currency',
        currency: config.currency || 'BRL'
      }).format((Number(cents) || 0) / 100);
    };

    const sanitizeDigits = (value) => String(value || '').replace(/\D/g, '');

    const formatCnpj = (value) => {
      const digits = sanitizeDigits(value).slice(0, 14);
      return digits
        .replace(/^(\d{2})(\d)/, '$1.$2')
        .replace(/^(\d{2})\.(\d{3})(\d)/, '$1.$2.$3')
        .replace(/\.(\d{3})(\d)/, '.$1/$2')
        .replace(/(\d{4})(\d)/, '$1-$2');
    };

    const formatCep = (value) => {
      const digits = sanitizeDigits(value).slice(0, 8);
      return digits.replace(/^(\d{5})(\d)/, '$1-$2');
    };

    const isValidCnpj = (value) => {
      const cnpj = sanitizeDigits(value);
      if (cnpj.length !== 14 || /^(\d)\1+$/.test(cnpj)) return false;

      const calc = (base, factors) => {
        const sum = base
          .split('')
          .reduce((acc, digit, index) => acc + Number(digit) * factors[index], 0);
        const mod = sum % 11;
        return mod < 2 ? 0 : 11 - mod;
      };

      const d1 = calc(cnpj.slice(0, 12), [5,4,3,2,9,8,7,6,5,4,3,2]);
      const d2 = calc(cnpj.slice(0, 13), [6,5,4,3,2,9,8,7,6,5,4,3,2]);

      return Number(cnpj[12]) === d1 && Number(cnpj[13]) === d2;
    };

    const showMessage = (type, message) => {
      const error = root.querySelector('[data-global-error]');
      const success = root.querySelector('[data-global-success]');

      error.hidden = true;
      success.hidden = true;

      if (!message) return;

      const target = type === 'success' ? success : error;
      target.textContent = message;
      target.hidden = false;
      target.scrollIntoView({ behavior: 'smooth', block: 'center' });
    };

    const syncWholesaleModeUi = () => {
      const banner = root.querySelector('[data-wholesale-mode]');
      const title = root.querySelector('[data-wholesale-mode-title]');
      const message = root.querySelector('[data-wholesale-mode-message]');
      const confirmButton = root.querySelector('[data-confirm-order]');
      const saveButton = root.querySelector('[data-save-proposal]');
      const liveLabel = root.querySelector('[data-live-label]');
      const simulation = state.flow === 'simulation';

      banner.classList.remove('is-loading', 'is-test', 'is-live', 'is-error');
      banner.hidden = false;
      message.hidden = false;

      if (state.modeError) {
        banner.classList.add('is-error');
        title.textContent = 'Modo seguro ativado';
        message.textContent =
          'Não foi possível confirmar a configuração da loja. A criação de pedidos está bloqueada.';
      } else if (!state.modeLoaded) {
        banner.classList.add('is-loading');
        title.textContent = 'Verificando modo da loja...';
        message.textContent =
          'A criação de pedidos permanece bloqueada até a configuração ser confirmada.';
      } else if (state.testMode) {
        banner.classList.add('is-test');
        title.textContent = 'Modo teste ativo';
        message.hidden = true;
      } else {
        banner.hidden = true;
      }

      if (liveLabel) {
        liveLabel.textContent = state.olistConfirmed
          ? 'Pedido enviado para análise'
          : state.testMode
            ? 'Criação de pedido bloqueada no modo teste'
            : 'Enviar pedido pendente para análise';
      }

      confirmButton.disabled =
        !state.modeLoaded ||
        state.modeError ||
        state.testMode ||
        state.olistConfirmed ||
        !state.olistCalculated ||
        !state.olistOrderId;
      root.querySelector('[data-simulation-email-field]').hidden = !simulation;
      root.querySelectorAll('[data-fiscal-only]').forEach((element) => { element.hidden = simulation; });
      root.querySelector('[data-olist-result]').hidden = simulation;
      root.querySelector('[data-simulation-notice]').hidden = !simulation;
      root.querySelector('[data-simulation-actions]').hidden = !simulation;
      root.querySelector('[data-step="2"] .atacado__tax-notice p').textContent = simulation
        ? 'Selecione produtos e varia\u00e7\u00f5es. O frete n\u00e3o est\u00e1 inclu\u00eddo e ser\u00e1 calculado ap\u00f3s a compra, conforme a forma de entrega ou retirada escolhida.'
        : 'Selecione os produtos e quantidades. Ao avan\u00e7ar, os dados ser\u00e3o enviados \u00e0 Olist para recalcular e confirmar o total do pedido.';
      root.querySelector('[data-go-summary]').textContent = simulation
        ? 'Ver simula\u00e7\u00e3o comercial' : 'Confirmar total no Olist';
      saveButton.textContent = simulation ? 'Enviar proposta comercial' : {{ section.settings.texto_botao_proposta | json }};
      saveButton.disabled = state.currentStep !== 3 || (!simulation && !state.testMode && !state.olistCalculated);
    };

    const loadWholesaleMode = async () => {
      state.testMode = true;
      state.modeLoaded = false;
      state.modeError = false;
      syncWholesaleModeUi();

      if (!config.modeEndpoint) {
        state.modeError = true;
        syncWholesaleModeUi();
        return;
      }

      try {
        const response = await fetch(config.modeEndpoint, {
          method: 'GET',
          headers: { Accept: 'application/json' },
          credentials: 'same-origin'
        });
        const result = await response.json();

        if (!response.ok || result.ok === false) {
          throw new Error(result.error || `Falha HTTP ${response.status}.`);
        }

        state.testMode = result.testMode !== false;
        const detailedFields = root.querySelector('[data-cnpj-detailed-fields]');
        if (detailedFields) {
          detailedFields.hidden = config.cnpjDataLevel !== 'complete';
        }
        state.modeLoaded = true;
      } catch (error) {
        console.error('Falha ao carregar o modo de atacado.', error);
        state.testMode = true;
        state.modeLoaded = false;
        state.modeError = true;
      }

      syncWholesaleModeUi();
    };

    const setStep = (step) => {
      state.currentStep = step;

      root.querySelectorAll('[data-step]').forEach((panel) => {
        panel.hidden = Number(panel.dataset.step) !== step;
      });

      root.querySelectorAll('[data-step-indicator]').forEach((indicator) => {
        indicator.classList.toggle(
          'is-active',
          Number(indicator.dataset.stepIndicator) === step
        );
      });

      showMessage('', '');
      syncWholesaleModeUi();
      root.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    const getTier = (totalQty) => {
      if (totalQty >= 100) return 'tier3';
      if (totalQty >= 50) return 'tier2';
      if (totalQty >= Number(config.minimumWholesale || 10)) return 'tier1';
      return 'retail';
    };

    const getTierLabel = (tier) => {
      if (tier === 'per_model') return 'Faixas separadas por modelo para cliente recorrente';
      if (tier === 'tier3') return 'Faixa de 100+ unidades';
      if (tier === 'tier2') return 'Faixa de 50–99 unidades';
      if (tier === 'tier1') return `Faixa de ${config.minimumWholesale || 10}–49 unidades`;
      return 'Abaixo do mínimo de atacado';
    };

    const getProductPrice = (product, tier) => {
      if (tier === 'retail') return 0;
      return product[tier] || 0;
    };

    const modelNameFromProduct = (product) =>
      String(product?.name || '').split(' — ')[0].trim() || 'produto';

    const wholesaleSelectionError = () => {
      const minimum = Number(config.minimumWholesale || 10);

      if (state.totalQty < minimum) {
        return `Selecione pelo menos ${minimum} unidades para usar a tabela de atacado.`;
      }

      if (state.pricingMode !== 'per_model') return '';

      const modelQuantities = new Map();
      state.products
        .filter((product) => product.qty > 0)
        .forEach((product) => {
          const current = modelQuantities.get(product.modelId) || {
            name: modelNameFromProduct(product),
            quantity: 0
          };
          current.quantity += product.qty;
          modelQuantities.set(product.modelId, current);
        });
      const invalidModel = [...modelQuantities.values()].find(
        (model) => model.quantity < minimum
      );

      return invalidModel
        ? `Cliente recorrente: o modelo ${invalidModel.name} precisa ter pelo menos ${minimum} unidades.`
        : '';
    };

    const syncMobileQty = (productId, value) => {
      const card = mobileCards.find((item) => item.dataset.productId === productId);
      if (!card) return;
      card.querySelector('[data-mobile-qty]').value = value;
    };

    const syncDesktopQty = (productId, value) => {
      const row = rows.find((item) => item.dataset.productId === productId);
      if (!row) return;
      row.querySelector('[data-qty-input]').value = value;
    };

    const calculate = () => {
      state.totalQty = state.products.reduce((sum, product) => sum + product.qty, 0);
      const globalTier = getTier(state.totalQty);
      state.tier = state.pricingMode === 'per_model' ? 'per_model' : globalTier;
      state.subtotal = 0;
      const modelTotals = new Map();

      state.products.forEach((product) => {
        const modelTotal = modelTotals.get(product.modelId) || {
          quantity: 0,
          subtotal: 0,
          unitPrice: 0,
          tier: 'retail'
        };
        modelTotal.quantity += product.qty;
        modelTotals.set(product.modelId, modelTotal);
      });

      state.products.forEach((product) => {
        const modelTotal = modelTotals.get(product.modelId);
        const productTier =
          state.pricingMode === 'per_model'
            ? getTier(modelTotal.quantity)
            : globalTier;
        product.priceTier = productTier;
        product.unitPrice = getProductPrice(product, productTier);
        product.subtotal = product.unitPrice * product.qty;
        state.subtotal += product.subtotal;
        modelTotal.subtotal += product.subtotal;
        modelTotal.unitPrice = product.unitPrice;
        modelTotal.tier = productTier;

        const row = rows.find((item) => item.dataset.productId === product.id);
        if (row) {
          row.classList.toggle('is-applied', product.qty > 0);
        }

        const card = mobileCards.find((item) => item.dataset.productId === product.id);
        if (card) {
          card.classList.toggle('is-applied', product.qty > 0);
        }
      });

      root.querySelectorAll('[data-model-qty]').forEach((element) => {
        element.textContent = modelTotals.get(element.dataset.modelQty)?.quantity || 0;
      });

      root.querySelectorAll('[data-model-summary]').forEach((row) => {
        const model = modelTotals.get(row.dataset.modelSummary) || {
          quantity: 0,
          subtotal: 0,
          unitPrice: 0,
          tier: 'retail'
        };
        const hasWholesalePrice = model.quantity > 0 && model.tier !== 'retail';
        row.querySelector('[data-model-unit]').textContent =
          hasWholesalePrice ? money(model.unitPrice) : '—';
        row.querySelector('[data-model-subtotal]').textContent =
          hasWholesalePrice ? money(model.subtotal) : '—';
        row.classList.toggle('is-applied', model.quantity > 0);
        row.querySelectorAll('[data-price-cell]').forEach((cell) => {
          cell.classList.toggle(
            'is-current',
            hasWholesalePrice && cell.dataset.priceCell === model.tier
          );
        });
      });

      root.querySelectorAll('[data-mobile-model-summary]').forEach((card) => {
        const model = modelTotals.get(card.dataset.mobileModelSummary) || {
          quantity: 0,
          subtotal: 0,
          unitPrice: 0,
          tier: 'retail'
        };
        const hasWholesalePrice = model.quantity > 0 && model.tier !== 'retail';
        card.querySelector('[data-mobile-model-unit]').textContent =
          hasWholesalePrice ? money(model.unitPrice) : '—';
        card.querySelector('[data-mobile-model-subtotal]').textContent =
          hasWholesalePrice ? money(model.subtotal) : '—';
      });

      calculateDiscount();

      root.querySelector('[data-total-quantidade]').textContent = state.totalQty;
      root.querySelector('[data-faixa-atual]').textContent = getTierLabel(state.tier);
    };

    const calculateDiscount = () => {
      const type = root.querySelector('[data-discount-type]').value;
      const input = root.querySelector('[data-discount-value]');
      const rawValue = Number(input.value || 0);

      input.disabled = type === 'nenhum';
      if (type === 'nenhum') {
        input.value = '0';
        state.discount = 0;
      } else if (type === 'percentual') {
        const percent = Math.min(Math.max(rawValue, 0), 100);
        state.discount = Math.round(state.subtotal * (percent / 100));
      } else {
        state.discount = Math.min(Math.round(Math.max(rawValue, 0) * 100), state.subtotal);
      }

      const baseAfterDiscount = Math.max(state.subtotal - state.discount, 0);
      if (!state.olistCalculated) state.total = baseAfterDiscount;

      root.querySelector('[data-summary-qty]').textContent = state.totalQty;
      root.querySelector('[data-summary-subtotal]').textContent = money(state.subtotal);
      root.querySelector('[data-summary-discount]').textContent = `− ${money(state.discount)}`;

      if (state.olistCalculated) {
        root.querySelector('[data-summary-total]').textContent = money(state.total);
      }
    };

    const updateProductQty = (productId, value) => {
      const product = state.products.find((item) => item.id === productId);
      if (!product) return;

      product.qty = Math.max(0, Math.floor(Number(value) || 0));
      state.olistCalculated = false;
      state.olistValues = null;
      state.olistConfirmed = false;
      syncDesktopQty(productId, product.qty);
      syncMobileQty(productId, product.qty);
      calculate();
    };

    const buildAddress = (data) => {
      const parts = [
        [data.logradouro, data.numero].filter(Boolean).join(', '),
        data.complemento,
        data.bairro,
        [data.municipio || data.cidade, data.uf].filter(Boolean).join(' - '),
        data.cep ? `CEP ${formatCep(data.cep)}` : ''
      ].filter(Boolean);

      return parts.join(' | ');
    };

    const normalizeCnpjResponse = (data) => {
      const source = data?.data || data?.company || data || {};
      const addressSource =
        source.estabelecimento || source.endereco || source.address || source;
      const fiscalSource =
        source.fiscal || source.estadual || source.stateRegistration || source;

      return {
        razao_social:
          source.razao_social || source.legalName || source.nome || source.name || '',
        nome_fantasia:
          source.nome_fantasia || source.tradeName || source.fantasia ||
          source.trade_name || '',
        situacao_cadastral:
          source.situacao_cadastral || source.registrationStatus ||
          source.descricao_situacao_cadastral || '',
        email: source.email || addressSource.email || source.emails?.[0] || '',
        telefone:
          source.telefone || source.phone || source.ddd_telefone_1 || source.ddd_telefone_2 ||
          addressSource.telefone1 || addressSource.telefone || '',
        logradouro:
          addressSource.logradouro || addressSource.street || addressSource.formatted || '',
        numero: addressSource.numero || addressSource.number || '',
        complemento:
          addressSource.complemento || addressSource.complement ||
          addressSource.details || '',
        bairro: addressSource.bairro || addressSource.district || '',
        municipio:
          addressSource.municipio?.descricao || addressSource.municipio ||
          addressSource.cidade || addressSource.city || '',
        uf: addressSource.estado?.sigla || addressSource.uf || addressSource.state || '',
        cep: addressSource.cep || addressSource.postalCode || addressSource.zip || '',
        inscricao_estadual:
          source.inscricao_estadual || source.ie || fiscalSource.inscricao_estadual ||
          fiscalSource.number || '',
        situacao_ie:
          source.situacao_ie || fiscalSource.situacao_ie || fiscalSource.situacao ||
          fiscalSource.status || '',
        contribuinte_icms:
          source.contribuinte_icms ?? fiscalSource.contribuinte_icms ??
          fiscalSource.icmsTaxpayer ?? null
      };
    };

    const normalizeContributor = (value) => {
      if (value === true || value === 1) return 'sim';
      if (value === false || value === 0) return 'nao';

      const normalized = String(value ?? '')
        .trim()
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '');

      if (['sim', 's', 'true', '1', 'contribuinte'].includes(normalized)) return 'sim';
      if (['nao', 'n', 'false', '0', 'nao contribuinte'].includes(normalized)) return 'nao';
      return '';
    };

    const applyCnpjData = (company) => {
      form.elements.destino_uf.value = company.uf || '';
      form.elements.destino_cidade.value = company.municipio || '';
      form.elements.destino_cep.value = sanitizeDigits(company.cep || '');
      form.elements.contribuinte_icms.value = normalizeContributor(company.contribuinte_icms);
      form.elements.inscricao_estadual.value = company.inscricao_estadual || '';
      form.elements.situacao_ie.value = company.situacao_ie || '';
      form.elements.situacao_cadastral.value = company.situacao_cadastral || '';
      form.elements.nome_fantasia.value = company.nome_fantasia || '';
      form.elements.telefone_empresa.value = company.telefone || '';
      form.elements.email_empresa.value = company.email || '';
      form.elements.cadastro_logradouro.value = company.logradouro || '';
      form.elements.cadastro_numero.value = company.numero || '';
      form.elements.cadastro_complemento.value = company.complemento || '';
      form.elements.cadastro_bairro.value = company.bairro || '';
      form.elements.cadastro_cidade.value = company.municipio || '';
      form.elements.cadastro_uf.value = company.uf || '';
      form.elements.cadastro_cep.value = sanitizeDigits(company.cep || '');
      form.elements.cnpj_consultado.value = 'sim';
    };

    const consultCnpj = async () => {
      const button = root.querySelector('[data-consultar-cnpj]');
      const input = form.elements.cnpj;
      const status = root.querySelector('[data-cnpj-status]');
      const cnpj = sanitizeDigits(input.value);

      if (!isValidCnpj(cnpj)) {
        status.textContent = 'CNPJ inválido. Confira os 14 dígitos.';
        showMessage('error', 'Digite um CNPJ válido antes de consultar.');
        return;
      }

      button.disabled = true;
      button.textContent = 'Consultando...';
      status.textContent = 'Buscando dados cadastrais...';

      try {
        let requestUrl = '';

        if (!config.cnpjEndpoint) {
          requestUrl = `https://brasilapi.com.br/api/cnpj/v1/${encodeURIComponent(cnpj)}`;
        } else if (config.cnpjEndpoint.includes('{cnpj}')) {
          requestUrl = config.cnpjEndpoint.replace(
            '{cnpj}',
            encodeURIComponent(cnpj)
          );
        } else {
          const separator = config.cnpjEndpoint.includes('?') ? '&' : '?';
          requestUrl =
            `${config.cnpjEndpoint}${separator}cnpj=${encodeURIComponent(cnpj)}`;
        }

        const response = await fetch(requestUrl, {
          method: 'GET',
          headers: { Accept: 'application/json' }
        });

        if (!response.ok) throw new Error(`Falha HTTP ${response.status}`);

        const raw = await response.json();
        const company = normalizeCnpjResponse(raw);
        const pricingMode = raw?.pricing?.mode;

        if (!['mixed', 'per_model'].includes(pricingMode)) {
          throw new Error('Não foi possível verificar o histórico de compras deste CNPJ.');
        }

        const registeredAddress = buildAddress(company);
        const dataLevel = ['verify', 'essential', 'complete'].includes(config.cnpjDataLevel)
          ? config.cnpjDataLevel
          : 'complete';
        const shouldFillEssential = ['essential', 'complete'].includes(dataLevel);

        if (shouldFillEssential && company.razao_social) {
          form.elements.razao_social.value = company.razao_social;
        }
        if (shouldFillEssential && registeredAddress) {
          form.elements.endereco_cadastrado.value = registeredAddress;
        }
        state.pricingMode = pricingMode;
        state.pricingVerified = true;
        calculate();
        applyCnpjData(company);

        form.elements.simulation_email.value = company.email || form.elements.simulation_email.value;
        const emailCard = root.querySelector('[data-email-card]');
        const emailField = form.elements.email;
        if (shouldFillEssential && company.email) {
          emailField.value = company.email;
        }
        emailCard.hidden = Boolean(emailField.value);
        emailField.required = !emailField.value;

        if (
          shouldFillEssential &&
          !form.elements.telefone_contato.value &&
          company.telefone
        ) {
          form.elements.telefone_contato.value = company.telefone;
        }

        const levelNotice =
          dataLevel === 'verify'
            ? ' CNPJ e regra de preços verificados; informe os dados comerciais manualmente.'
            : dataLevel === 'essential'
              ? ' Dados essenciais disponíveis foram preenchidos.'
              : ' Todos os dados disponíveis foram preenchidos.';
        const missingFields = [
          !String(form.elements.endereco_cadastrado.value || '').trim()
            ? 'endereço cadastrado'
            : '',
          !String(emailField.value || '').trim() ? 'e-mail comercial' : '',
          !String(form.elements.telefone_contato.value || '').trim()
            ? 'telefone/WhatsApp'
            : ''
        ].filter(Boolean);
        const manualNotice = missingFields.length
          ? ` Preencha manualmente: ${missingFields.join(', ')}.`
          : '';
        const pricingNotice =
          pricingMode === 'per_model'
            ? ' Cliente recorrente: faixas e mínimo calculados separadamente por modelo.'
            : ' Primeira compra: faixa calculada pelo mix total de produtos.';

        status.textContent = `Consulta concluída.${levelNotice}${manualNotice}${pricingNotice}`;
        showMessage(
          'success',
          `Consulta concluída.${levelNotice}${manualNotice}${pricingNotice}`
        );
      } catch (error) {
        console.error(error);
        status.textContent = 'Não foi possível consultar. Preencha os dados manualmente.';
        showMessage(
          'error',
          error?.message || 'Não foi possível consultar o CNPJ agora.'
        );
      } finally {
        button.disabled = false;
        button.textContent = 'Verificar CNPJ';
      }
    };

    const validateStepOne = () => {
      const required = [
        'vendedor',
        'comprador',
        'telefone_contato',
        'cnpj',
        'email',
        'endereco_cadastrado',
        'consentimento'
      ];

      if (form.elements.endereco_correto.value === 'nao') {
        required.push(
          'entrega_logradouro',
          'entrega_numero',
          'entrega_bairro',
          'entrega_cidade',
          'entrega_uf',
          'entrega_cep'
        );
      }

      if (form.elements.cnpj_consultado.value !== 'sim') {
        form.elements.cnpj.focus();
        showMessage('error', 'Consulte o CNPJ antes de continuar.');
        return false;
      }
      if (!state.pricingVerified) {
        showMessage('error', 'Consulte novamente o CNPJ para verificar a regra de preços.');
        return false;
      }

      for (const name of required) {
        const field = form.elements[name];
        const isCheckbox = field?.type === 'checkbox';
        const isEmpty = isCheckbox ? !field.checked : !String(field?.value || '').trim();

        if (isEmpty) {
          field?.focus();
          showMessage('error', 'Preencha todos os campos obrigatórios antes de continuar.');
          return false;
        }
      }

      if (!isValidCnpj(form.elements.cnpj.value)) {
        form.elements.cnpj.focus();
        showMessage('error', 'O CNPJ informado não é válido.');
        return false;
      }

      return true;
    };

    const pickNumber = (source, paths) => {
      for (const path of paths) {
        const value = path.split('.').reduce((current, key) => current?.[key], source);
        if (value !== undefined && value !== null && value !== '') {
          const number = Number(String(value).replace(',', '.'));
          if (Number.isFinite(number)) return number;
        }
      }
      return 0;
    };

    const toCents = (value, response) => {
      if (!Number.isFinite(value)) return 0;
      return response?.values_in_cents === true || response?.currency_unit === 'cents'
        ? Math.round(value)
        : Math.round(value * 100);
    };

    const normalizeOlistResponse = (response) => {
      const source = response?.data || response?.pedido || response?.order || response;
      const products = toCents(pickNumber(source, ['values.commercial_subtotal','values.products','values.produtos','total_produtos','subtotal','valor_produtos']), response);
      const discount = toCents(pickNumber(source, ['values.commercial_discount','values.discount','values.desconto','desconto','valor_desconto']), response);
      const totalSent = toCents(pickNumber(source, ['values.total_sent_to_olist']), response);
      const ipi = toCents(pickNumber(source, ['values.ipi','impostos.ipi','valor_ipi','ipi']), response);
      const icms = toCents(pickNumber(source, ['values.icms_fcp','values.icms','impostos.icms_fcp','impostos.icms','valor_icms']), response);
      const st = toCents(pickNumber(source, ['values.icms_st_fcp_st','values.st','impostos.icms_st_fcp_st','valor_icms_st','icms_st']), response);
      const pis = toCents(pickNumber(source, ['values.pis','impostos.pis','valor_pis']), response);
      const cofins = toCents(pickNumber(source, ['values.cofins','impostos.cofins','valor_cofins']), response);
      const cbs = toCents(pickNumber(source, ['values.cbs','impostos.cbs','valor_cbs']), response);
      const ibsState = toCents(pickNumber(source, ['values.ibs_state','values.ibs_estadual','impostos.ibs_estadual']), response);
      const ibsCity = toCents(pickNumber(source, ['values.ibs_city','values.ibs_municipal','impostos.ibs_municipal']), response);
      const difal = toCents(pickNumber(source, ['values.difal','impostos.difal','valor_difal']), response);
      const total = toCents(pickNumber(source, ['values.total_confirmed_by_olist','values.total','total','total_pedido','valor_total']), response);
      return {
        orderId: String(source?.olist_order_id || source?.pedido_id || source?.order_id || source?.id || ''),
        orderNumber: String(source?.numero || source?.order_number || source?.numero_pedido || ''),
        status: String(source?.status || source?.situacao || 'em_aberto'),
        paymentUrl: String(source?.payment_url || source?.link_pagamento || source?.cobranca?.url || ''),
        taxBreakdownAvailable: response?.tax_breakdown_available === true,
        taxEstimateAvailable: response?.app_tax_estimate_available === true,
        products, discount, totalSent, ipi, icms, st,
        other: pis + cofins + cbs + ibsState + ibsCity + difal,
        total
      };
    };

    const renderOlistValues = (values) => {
      const productsTotal = values.products > 0 ? values.products : state.subtotal;
      const discountTotal = values.discount >= 0 ? values.discount : state.discount;
      const totalSent = values.totalSent > 0
        ? values.totalSent
        : Math.max(productsTotal - discountTotal, 0);
      const taxTotal = values.ipi + values.icms + values.st + values.other;
      const taxDetails = root.querySelector('[data-tax-breakdown-details]');
      const taxUnavailable = root.querySelector('[data-tax-breakdown-unavailable]');

      root.querySelector('[data-summary-subtotal]').textContent = money(productsTotal);
      root.querySelector('[data-summary-discount]').textContent = `− ${money(discountTotal)}`;
      root.querySelector('[data-olist-total-sent]').textContent = money(totalSent);
      root.querySelector('[data-summary-total-label]').textContent = 'Total confirmado pelo Olist';
      taxDetails.hidden = !values.taxBreakdownAvailable;
      taxUnavailable.hidden = values.taxBreakdownAvailable;
      root.querySelector('[data-olist-ipi]').textContent = values.taxBreakdownAvailable ? money(values.ipi) : '—';
      root.querySelector('[data-olist-icms]').textContent = values.taxBreakdownAvailable ? money(values.icms) : '—';
      root.querySelector('[data-olist-st]').textContent = values.taxBreakdownAvailable ? money(values.st) : '—';
      root.querySelector('[data-olist-other]').textContent = values.taxBreakdownAvailable ? money(values.other) : '—';
      root.querySelector('[data-olist-tax-total]').textContent = values.taxBreakdownAvailable ? money(taxTotal) : '—';
      root.querySelector('[data-summary-total]').textContent = money(values.total);
      root.querySelector('[data-olist-message]').textContent =
        values.taxBreakdownAvailable
          ? `Total e detalhamento recebidos do Olist. Pedido aberto: ${values.orderId}.`
          : `Total confirmado no pedido aberto ${values.orderId}. Nenhum tributo foi somado novamente pelo app.`;

      const status = root.querySelector('[data-recalculate-status]');
      status.classList.remove('is-stale');
      status.classList.add('is-success');
      status.textContent = `Valores atualizados pelo Olist às ${new Date().toLocaleTimeString(config.locale || 'pt-BR', { hour: '2-digit', minute: '2-digit' })}.`;

      syncWholesaleModeUi();
    };

    const renderTestPreview = () => {
      state.olistOrderId = '';
      state.olistCalculated = false;
      state.olistValues = null;
      state.olistConfirmed = false;
      state.total = Math.max(state.subtotal - state.discount, 0);

      root.querySelector('[data-summary-subtotal]').textContent = money(state.subtotal);
      root.querySelector('[data-summary-discount]').textContent = `− ${money(state.discount)}`;
      root.querySelector('[data-summary-total-label]').textContent = 'Total comercial de teste';
      root.querySelector('[data-summary-total]').textContent = money(state.total);
      root.querySelector('[data-olist-total-sent]').textContent = '—';
      root.querySelector('[data-tax-breakdown-details]').hidden = true;
      root.querySelector('[data-tax-breakdown-unavailable]').hidden = false;
      root.querySelector('[data-olist-ipi]').textContent = '—';
      root.querySelector('[data-olist-icms]').textContent = '—';
      root.querySelector('[data-olist-st]').textContent = '—';
      root.querySelector('[data-olist-other]').textContent = '—';
      root.querySelector('[data-olist-tax-total]').textContent = '—';
      root.querySelector('[data-olist-message]').textContent =
        'Pr\u00e9via comercial gerada sem criar um pedido. O frete n\u00e3o est\u00e1 inclu\u00eddo e ser\u00e1 calculado ap\u00f3s a compra.';

      const status = root.querySelector('[data-recalculate-status]');
      status.classList.remove('is-stale', 'is-success');
      status.textContent =
        'Pr\u00e9via comercial local atualizada.';

      syncWholesaleModeUi();
    };

    const renderSimulationPreview = () => {
      state.olistOrderId = '';
      state.olistCalculated = false;
      state.olistValues = null;
      state.olistConfirmed = false;
      state.total = Math.max(state.subtotal - state.discount, 0);
      root.querySelector('[data-summary-subtotal]').textContent = money(state.subtotal);
      root.querySelector('[data-summary-discount]').textContent = `- ${money(state.discount)}`;
      root.querySelector('[data-summary-total-label]').textContent = 'Total dos produtos';
      root.querySelector('[data-summary-total]').textContent = money(state.total);
      const status = root.querySelector('[data-recalculate-status]');
      status.classList.remove('is-stale', 'is-success');
      status.textContent = 'Simula\u00e7\u00e3o comercial atualizada. O frete n\u00e3o est\u00e1 inclu\u00eddo e ser\u00e1 calculado ap\u00f3s a compra.';
      syncWholesaleModeUi();
    };

    const calculateWithOlist = async (allowNewQuoteRetry = true) => {
      if (!config.olistEndpoint) {
        throw new Error('Configure o endpoint de cálculo do Olist no editor desta seção.');
      }

      const selectedProducts = state.products.filter((product) => product.qty > 0);
      const productsWithoutSku = selectedProducts.filter((product) => !String(product.sku || '').trim());

      if (productsWithoutSku.length > 0) {
        throw new Error(
          `Informe o SKU do Olist para: ${productsWithoutSku.map((product) => product.name).join(', ')}.`
        );
      }

      const response = await fetch(config.olistEndpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(proposalPayload())
      });

      const rawText = await response.text();
      let result = {};
      try { result = rawText ? JSON.parse(rawText) : {}; } catch (_) {}

      if (!response.ok || result.success === false) {
        if (allowNewQuoteRetry && result.code === 'QUOTE_IDENTITY_CHANGED') {
          startNewQuote();
          return calculateWithOlist(false);
        }

        const error = new Error(
          result.message || result.error || `Olist retornou erro HTTP ${response.status}.`
        );
        error.code = result.code || '';
        throw error;
      }

      const values = normalizeOlistResponse(result);
      if (!values.total) throw new Error('O Olist não retornou o total calculado.');

      state.olistOrderId = values.orderId;
      state.olistValues = values;
      state.olistCalculated = true;
      state.total = values.total;
      renderOlistValues(values);
    };

    const renderSummary = () => {
      const container = root.querySelector('[data-summary-items]');
      const selected = state.products.filter((product) => product.qty > 0);

      container.innerHTML = selected.map((product) => `
        <div class="atacado__summary-item">
          <div>
            <strong>${escapeHtml(product.name)}</strong>
            <span>${product.qty} un. × ${money(product.unitPrice)}</span>
          </div>
          <span>${getTierLabel(state.tier)}</span>
          <strong>${money(product.subtotal)}</strong>
        </div>
      `).join('');

      calculateDiscount();
    };

    const escapeHtml = (value) => {
      return String(value || '').replace(/[&<>"']/g, (char) => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#039;'
      }[char]));
    };

    const proposalPayload = () => {
      const formData = Object.fromEntries(new FormData(form).entries());

      const shippingAddress =
        form.elements.endereco_correto.value === 'sim'
          ? form.elements.endereco_cadastrado.value
          : buildAddress({
              logradouro: form.elements.entrega_logradouro.value,
              numero: form.elements.entrega_numero.value,
              complemento: form.elements.entrega_complemento.value,
              bairro: form.elements.entrega_bairro.value,
