  {% comment %}
    LP Varejo Mibro — use em um template de pagina exclusivo.
    Os links, video, imagens e produtos sao editaveis no Theme Editor.
  {% endcomment %}
  
{% liquid
  assign section_id = 'MibroB2B-' | append: section.id
  assign contact_return_url = page.url | append: '?contact_posted=true'
  assign use_native_contact_submit = false
  if template.suffix == 'atacado'
    assign use_native_contact_submit = true
  endif
  assign campaign_label = section.settings.campaign_name | default: 'Atacado Principal'
  case template.suffix
    when 'atacado'
      assign campaign_label = 'Atacado Principal'
    when 'varejo'
      assign campaign_label = 'Atacado Principal'
    when 'atacado1'
      assign campaign_label = 'Teste A'
    when 'atacado2'
      assign campaign_label = 'Teste B'
  endcase
%}
  
  <section id="{{ section_id }}" class="mb-b2b">
    <div class="mb-b2b__hero mb-b2b__container">
      <div class="mb-b2b__eyebrow">{{ section.settings.eyebrow | escape }}</div>
      <h1>{{ section.settings.heading | escape }}</h1>
      <p class="mb-b2b__subheading">{{ section.settings.subheading | escape }}</p>
  
      <div class="mb-b2b__video-wrap">
        {% if section.settings.video != blank %}
        {{ section.settings.video | video_tag: image_size: '1600x', autoplay: false, loop: false, muted: false, controls: true, controlslist: 'nodownload nofullscreen noremoteplayback', disablepictureinpicture: true, playsinline: true, class: 'mb-b2b__video' }}
        {% elsif section.settings.video_url != blank %}
          {% if section.settings.video_url.type == 'youtube' %}
          <iframe src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?rel=0&fs=0" title="Vídeo Mibro para lojistas" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope" loading="lazy"></iframe>
          {% else %}
          <iframe src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?fullscreen=0" title="Vídeo Mibro para lojistas" allow="autoplay" loading="lazy"></iframe>
          {% endif %}
        {% else %}
          <div class="mb-b2b__video-placeholder"><span>Adicione o vídeo da campanha no editor do tema</span></div>
        {% endif %}
      </div>
    </div>
  
    <div class="mb-b2b__benefits mb-b2b__container">
      {% for block in section.blocks %}
        {% if block.type == 'benefit' %}
          <div class="mb-b2b__benefit" {{ block.shopify_attributes }}>
            <span class="mb-b2b__benefit-media">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 120 | image_tag: loading: 'lazy', class: 'mb-b2b__benefit-image', alt: block.settings.text }}
              {% elsif block.settings.icon != blank %}
                <span class="mb-b2b__benefit-icon" aria-hidden="true">{{ block.settings.icon | escape }}</span>
              {% else %}
                <span class="mb-b2b__number">0{{ forloop.index }}</span>
              {% endif %}
            </span>
            <span>{{ block.settings.text | escape }}</span>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  
    <div class="mb-b2b__cta-wrap mb-b2b__container">
      <div class="mb-b2b__gate" data-form-gate>
        <span class="mb-b2b__gate-panel mb-b2b__gate-panel--top" aria-hidden="true"></span>
        <span class="mb-b2b__gate-panel mb-b2b__gate-panel--bottom" aria-hidden="true"></span>
        <button class="mb-b2b__cta mb-b2b__gate-button" type="button" data-open-partner-form>{{ section.settings.cta_text | escape }} <span aria-hidden="true">↓</span></button>
      </div>
      {% if section.settings.cta_note != blank %}<p>{{ section.settings.cta_note | escape }}</p>{% endif %}
    </div>
  
    <div class="mb-b2b__form-shell mb-b2b__container" data-partner-form hidden>
      <div class="mb-b2b__form-heading">
        <span>Cadastro de parceiro</span>
        <h2>{{ section.settings.form_heading | escape }}</h2>
        <p>{{ section.settings.form_text | escape }}</p>
      </div>
    {% form 'contact', id: 'MibroPartnerForm', class: 'mb-b2b__form', return_to: contact_return_url %}
      <input type="hidden" name="contact[tags]" value="Lead LP Atacado Mibro - {{ campaign_label | escape }}">
      <input type="hidden" name="contact[Identificacao da campanha]" value="{{ campaign_label | escape }}">
      <input type="hidden" name="contact[Modelo da LP]" value="{{ template.suffix | escape }}">
      <input type="hidden" name="contact[Pagina da LP]" data-tracking="page_path">
      <input type="hidden" name="contact[URL completa]" data-tracking="page_url">
      <input type="hidden" name="contact[UTM source]" data-tracking="utm_source">
      <input type="hidden" name="contact[UTM medium]" data-tracking="utm_medium">
      <input type="hidden" name="contact[UTM campaign]" data-tracking="utm_campaign">
      <input type="hidden" name="contact[UTM content]" data-tracking="utm_content">
      <input type="hidden" name="contact[Referencia]" data-tracking="referrer">
      <input type="hidden" name="contact[body]" data-contact-body value="Novo cadastro de parceiro Mibro">
        {% if form.posted_successfully? %}<p class="mb-b2b__form-success" role="status">Cadastro enviado. O portfólio de preços foi liberado abaixo.</p>{% endif %}
        {{ form.errors | default_errors }}
        <div class="mb-b2b__form-grid">
          <label><span>Nome</span><input type="text" name="contact[name]" autocomplete="name" required></label>
          <label><span>E-mail</span><input type="email" name="contact[email]" autocomplete="email" required></label>
          <label><span>Número/WhatsApp</span><input type="tel" name="contact[phone]" autocomplete="tel" inputmode="numeric" placeholder="(11) 99999-9999" maxlength="15" data-phone required></label>
          <label><span>CNPJ</span><input type="text" name="contact[CNPJ]" inputmode="numeric" autocomplete="off" placeholder="00.000.000/0000-00" maxlength="18" data-cnpj data-cnpj-level="complete" required></label>
        </div>
        <p class="mb-b2b__ajax-status" data-form-status role="status" hidden></p>
        <button class="mb-b2b__cta mb-b2b__submit" type="button" data-submit-partner-form>{{ section.settings.form_submit_text | escape }} <span aria-hidden="true">→</span></button>
      {% endform %}
    </div>
  
    {% unless section.settings.show_pricing_table == false %}
      <div class="mb-b2b__products mb-b2b__container" data-price-catalog hidden>
        <div class="mb-b2b__section-heading"><span>Portfólio completo</span><h2>{{ section.settings.products_heading | escape }}</h2></div>
        <div class="mb-b2b__table-scroll" role="region" aria-label="Tabela de preços Mibro" tabindex="0">
          <table class="mb-b2b__price-table">
            <thead><tr><th>Produto</th><th>Varejo Unitário</th><th>10–49 un.</th><th>50–99 un.</th><th class="mb-b2b__best">100+ un.</th></tr></thead>
            <tbody>
              <tr class="mb-b2b__group"><th colspan="4">Essential Series</th><th class="mb-b2b__specialist">Fale com um de nossos especialistas</th></tr>
              <tr><th>{% if section.settings.link_c4 != blank %}<a href="{{ section.settings.link_c4 }}" target="_blank" rel="noopener noreferrer">Mibro C4</a>{% else %}Mibro C4{% endif %}</th><td>R$ 424</td><td>R$ 270</td><td>R$ 250</td><td class="mb-b2b__best">—</td></tr>
              <tr><th>{% if section.settings.link_a3 != blank %}<a href="{{ section.settings.link_a3 }}" target="_blank" rel="noopener noreferrer">Mibro A3</a>{% else %}Mibro A3{% endif %}</th><td>R$ 588</td><td>R$ 375</td><td>R$ 345</td><td class="mb-b2b__best">—</td></tr>
              <tr class="mb-b2b__group"><th colspan="4">Lifestyle Series</th><th class="mb-b2b__specialist">Fale com um de nossos especialistas</th></tr>
              <tr><th>{% if section.settings.link_lite_3 != blank %}<a href="{{ section.settings.link_lite_3 }}" target="_blank" rel="noopener noreferrer">Mibro Lite 3</a>{% else %}Mibro Lite 3{% endif %}</th><td>R$ 612</td><td>R$ 390</td><td>R$ 360</td><td class="mb-b2b__best">—</td></tr>
              <tr><th>{% if section.settings.link_lite_3_pro != blank %}<a href="{{ section.settings.link_lite_3_pro }}" target="_blank" rel="noopener noreferrer">Mibro Lite 3 Pro</a>{% else %}Mibro Lite 3 Pro{% endif %}</th><td>R$ 847</td><td>R$ 540</td><td>R$ 500</td><td class="mb-b2b__best">—</td></tr>
              <tr class="mb-b2b__group"><th colspan="4">Professional Sports Series</th><th class="mb-b2b__specialist">Fale com um de nossos especialistas</th></tr>
              <tr><th>{% if section.settings.link_gs_pro != blank %}<a href="{{ section.settings.link_gs_pro }}" target="_blank" rel="noopener noreferrer">Mibro GS Pro</a>{% else %}Mibro GS Pro{% endif %}</th><td>R$ 765</td><td>R$ 485</td><td>R$ 450</td><td class="mb-b2b__best">—</td></tr>
              <tr><th>{% if section.settings.link_gs_pro_2 != blank %}<a href="{{ section.settings.link_gs_pro_2 }}" target="_blank" rel="noopener noreferrer">Mibro GS Pro 2</a>{% else %}Mibro GS Pro 2{% endif %}</th><td>R$ 1.118</td><td>R$ 710</td><td>R$ 660</td><td class="mb-b2b__best">—</td></tr>
              <tr><th>{% if section.settings.link_gs_active != blank %}<a href="{{ section.settings.link_gs_active }}" target="_blank" rel="noopener noreferrer">Mibro GS Active</a>{% else %}Mibro GS Active{% endif %}</th><td>R$ 647</td><td>R$ 410</td><td>R$ 380</td><td class="mb-b2b__best">—</td></tr>
              <tr><th>{% if section.settings.link_gs_active_2 != blank %}<a href="{{ section.settings.link_gs_active_2 }}" target="_blank" rel="noopener noreferrer">Mibro GS Active 2</a>{% else %}Mibro GS Active 2{% endif %}</th><td>R$ 882</td><td>R$ 560</td><td>R$ 520</td><td class="mb-b2b__best">—</td></tr>
              <tr><th>{% if section.settings.link_gs_explorer != blank %}<a href="{{ section.settings.link_gs_explorer }}" target="_blank" rel="noopener noreferrer">Mibro GS Explorer</a>{% else %}Mibro GS Explorer{% endif %}</th><td>R$ 1.176</td><td>R$ 750</td><td>R$ 700</td><td class="mb-b2b__best">—</td></tr>
            </tbody>
          </table>
        </div>
        <p class="mb-b2b__table-note">Arraste para o lado para consultar todas as faixas de quantidade.</p>
      </div>
    {% endunless %}
  
    {% assign gallery_count = section.blocks | where: 'type', 'gallery' | size %}
    {% if gallery_count > 0 %}
      <div class="mb-b2b__marquee" aria-label="Galeria Mibro">
        <div class="mb-b2b__track">
          {% for repeat in (1..2) %}
            {% for block in section.blocks %}
              {% if block.type == 'gallery' and block.settings.image != blank %}
                <div class="mb-b2b__gallery-item" {% if repeat == 1 %}{{ block.shopify_attributes }}{% else %}aria-hidden="true"{% endif %}>{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', alt: block.settings.alt }}</div>
              {% endif %}
            {% endfor %}
          {% endfor %}
        </div>
      </div>
    {% endif %}
  
    <div class="mb-b2b__final">
      <div class="mb-b2b__container">
        <span>Wearables para todos os perfis</span>
        <h2>{{ section.settings.final_heading | escape }}</h2>
        <a class="mb-b2b__cta" href="{{ section.settings.final_cta_link | default: '#' }}" {% if section.settings.final_cta_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}>{{ section.settings.final_cta_text | escape }} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
  
  <script>
    (() => {
      const root = document.getElementById({{ section_id | json }});
      if (!root) return;
      const formShell = root.querySelector('[data-partner-form]');
      const form = formShell && formShell.querySelector('form');
      const catalog = root.querySelector('[data-price-catalog]');
      const gate = root.querySelector('[data-form-gate]');
    const cnpjInput = form && form.querySelector('[data-cnpj]');
    const phoneInput = form && form.querySelector('[data-phone]');
    const submitButton = form && form.querySelector('[data-submit-partner-form]');
    const campaignVideo = root.querySelector('.mb-b2b__video');
    const partnerButton = root.querySelector('[data-open-partner-form]');
    const storageKey = 'mibro-pricing-unlocked-v2-{{ section.id }}';

    const trackingParams = new URLSearchParams(window.location.search);
    const defaultCampaign = {{ campaign_label | json }};
    const useNativeContactSubmit = {{ use_native_contact_submit | json }};
    const leadSheetEndpoint = '/apps/cnpj-validator/atacado/registrar-lead';
    const trackingValues = {
      page_path: window.location.pathname,
      page_url: window.location.href,
      utm_source: trackingParams.get('utm_source') || 'direto',
      utm_medium: trackingParams.get('utm_medium') || 'nao informado',
      utm_campaign: trackingParams.get('utm_campaign') || defaultCampaign,
      utm_content: trackingParams.get('utm_content') || 'nao informado',
      referrer: document.referrer || 'acesso direto'
    };
    Object.entries(trackingValues).forEach(([key, value]) => {
      const field = form?.querySelector(`[data-tracking="${key}"]`);
      if (field) field.value = value;
    });

    function scrollElementToCenter(element, duration = 1600) {
      if (!element || element.offsetParent === null) return;
      const startY = window.scrollY;
      const rect = element.getBoundingClientRect();
      const desiredY = startY + rect.top - ((window.innerHeight - rect.height) / 2);
      const maxY = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
      const targetY = Math.min(Math.max(0, desiredY), maxY);
      const distance = targetY - startY;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        window.scrollTo(0, targetY);
        return;
      }
      const startedAt = performance.now();
      const animate = (now) => {
        const progress = Math.min((now - startedAt) / duration, 1);
        const eased = progress < 0.5
          ? 4 * progress * progress * progress
          : 1 - Math.pow(-2 * progress + 2, 3) / 2;
        window.scrollTo(0, startY + distance * eased);
        if (progress < 1) requestAnimationFrame(animate);
      };
      requestAnimationFrame(animate);
    }

    campaignVideo?.addEventListener('ended', () => {
      window.setTimeout(() => scrollElementToCenter(partnerButton), 250);
    });
  
      function formatCnpj(value) {
        return value.replace(/\D/g, '').slice(0, 14)
          .replace(/^(\d{2})(\d)/, '$1.$2')
          .replace(/^(\d{2})\.(\d{3})(\d)/, '$1.$2.$3')
          .replace(/\.(\d{3})(\d)/, '.$1/$2')
          .replace(/(\d{4})(\d)/, '$1-$2');
      }
  
      function formatPhone(value) {
        const digits = value.replace(/\D/g, '');
        if (digits.length > 11) return digits.slice(0, 15);
        if (digits.length <= 2) return digits.replace(/^(\d{1,2})/, '($1');
        if (digits.length <= 6) return digits.replace(/^(\d{2})(\d+)/, '($1) $2');
        if (digits.length <= 10) return digits.replace(/^(\d{2})(\d{4})(\d+)/, '($1) $2-$3');
        return digits.replace(/^(\d{2})(\d{5})(\d{4})$/, '($1) $2-$3');
      }
  
      function isValidPhone(value) {
        const digits = value.replace(/\D/g, '');
        const validDdds = new Set(['11','12','13','14','15','16','17','18','19','21','22','24','27','28','31','32','33','34','35','37','38','41','42','43','44','45','46','47','48','49','51','53','54','55','61','62','63','64','65','66','67','68','69','71','73','74','75','77','79','81','82','83','84','85','86','87','88','89','91','92','93','94','95','96','97','98','99']);
        if (!validDdds.has(digits.slice(0, 2))) return false;
        if (/^(\d)\1+$/.test(digits)) return false;
        if (digits.length === 11) return digits.charAt(2) === '9';
        if (digits.length === 10) return /^[2-5]/.test(digits.slice(2));
        return false;
      }
  
      function isValidCnpj(value) {
        const digits = value.replace(/\D/g, '');
        if (digits.length !== 14 || /^(\d)\1{13}$/.test(digits)) return false;
        const calculateDigit = (base, weights) => {
          const sum = base.split('').reduce((total, digit, index) => total + Number(digit) * weights[index], 0);
          const remainder = sum % 11;
          return remainder < 2 ? 0 : 11 - remainder;
        };
        const first = calculateDigit(digits.slice(0, 12), [5,4,3,2,9,8,7,6,5,4,3,2]);
        const second = calculateDigit(digits.slice(0, 12) + first, [6,5,4,3,2,9,8,7,6,5,4,3,2]);
        return digits.endsWith(`${first}${second}`);
      }
  
      cnpjInput?.addEventListener('input', () => {
        cnpjInput.value = formatCnpj(cnpjInput.value);
        cnpjInput.setCustomValidity('');
      });
  
      phoneInput?.addEventListener('input', () => {
        phoneInput.value = formatPhone(phoneInput.value);
        phoneInput.setCustomValidity('');
      });
      phoneInput?.addEventListener('blur', () => {
        phoneInput.setCustomValidity(isValidPhone(phoneInput.value) ? '' : 'Digite um telefone brasileiro válido com DDD.');
        if (phoneInput.value) phoneInput.reportValidity();
      });
  
      function openForm() {
        if (!formShell || gate?.classList.contains('is-opening')) return;
        gate?.classList.add('is-opening');
        window.setTimeout(() => {
          if (gate) gate.hidden = true;
          formShell.hidden = false;
          requestAnimationFrame(() => formShell.classList.add('is-open'));
          formShell.scrollIntoView({ behavior: 'smooth', block: 'center' });
          window.setTimeout(() => formShell.querySelector('input')?.focus(), 500);
        }, 680);
      }
  
      function unlockCatalog() {
        if (!catalog) return;
        catalog.classList.remove('is-open');
        catalog.hidden = false;
        void catalog.offsetHeight;
        window.setTimeout(() => catalog.classList.add('is-open'), 100);
      }
  
      root.querySelectorAll('[data-open-partner-form]').forEach((button) => button.addEventListener('click', openForm));
    const contactWasPosted = new URLSearchParams(window.location.search).get('contact_posted') === 'true' || !!formShell?.querySelector('.mb-b2b__form-success');
    if (contactWasPosted) {
      sessionStorage.setItem(storageKey, '1');
      if (gate) gate.hidden = true;
      if (formShell) formShell.hidden = true;
      unlockCatalog();
      window.setTimeout(() => {
        catalog?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 260);
    } else if (formShell?.querySelector('.errors')) {
      if (gate) gate.hidden = true;
      formShell.hidden = false;
      formShell.classList.add('is-open');
    } else if (sessionStorage.getItem(storageKey) === '1') {
      if (gate) gate.hidden = true;
      if (formShell) formShell.hidden = true;
      unlockCatalog();
    }
      submitButton?.addEventListener('click', async () => {
        if (!form.reportValidity()) return;
        if (phoneInput && !isValidPhone(phoneInput.value)) {
          phoneInput.setCustomValidity('Digite um telefone brasileiro válido com DDD.');
          phoneInput.reportValidity();
          phoneInput.focus();
          return;
        }
        if (cnpjInput && !isValidCnpj(cnpjInput.value)) {
          cnpjInput.setCustomValidity('Digite um CNPJ válido.');
          cnpjInput.reportValidity();
          cnpjInput.focus();
          return;
        }
        const contactBody = form.querySelector('[data-contact-body]');
        if (contactBody) {
          const fieldValue = (name) => form.querySelector(`[name="${name}"]`)?.value?.trim() || 'não informado';
          contactBody.value = [
            'Novo cadastro de parceiro Mibro',
            `Campanha: ${defaultCampaign}`,
            `Página: ${window.location.pathname}`,
            `Nome: ${fieldValue('contact[name]')}`,
            `E-mail: ${fieldValue('contact[email]')}`,
            `Telefone: ${fieldValue('contact[phone]')}`,
            `CNPJ: ${fieldValue('contact[CNPJ]')}`
          ].join('\n');
        }
        const status = form.querySelector('[data-form-status]');
      submitButton.disabled = true;
      if (status) {
        status.hidden = false;
        status.textContent = 'Enviando cadastro com segurança...';
        status.classList.remove('is-error');
      }

      const leadFieldValue = (name) => form.querySelector(`[name="${name}"]`)?.value?.trim() || '';
      const companyData = Object.fromEntries(
        Array.from(form.elements)
          .filter((field) => field.name?.startsWith('cnpj_') && field.value?.trim())
          .map((field) => [field.name.slice(5), field.value.trim()])
      );
      const leadId = globalThis.crypto?.randomUUID?.() || `${Date.now()}-${Math.random().toString(36).slice(2)}`;
      try {
        const sheetResponse = await fetch(leadSheetEndpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            quote_token: leadId,
            buyer_name: leadFieldValue('contact[name]'),
            buyer_email: leadFieldValue('contact[email]'),
            buyer_phone: leadFieldValue('contact[phone]'),
            cnpj: leadFieldValue('contact[CNPJ]'),
            company_data: companyData,
            campaign: defaultCampaign,
            template: {{ template.suffix | json }},
            ...trackingValues
          })
        });
        const sheetResult = await sheetResponse.json().catch(() => null);
        if (!sheetResponse.ok || sheetResult?.success !== true) throw new Error('sheet_sync_failed');
      } catch (error) {
        console.warn('O cadastro seguirá para a Shopify, mas a planilha não confirmou o registro.');
      }

      if (useNativeContactSubmit) {
        form.removeAttribute('target');
        form.requestSubmit();
        return;
      }
      if (status) { status.hidden = false; status.textContent = 'Enviando cadastro...'; status.classList.remove('is-error'); }

      const oldFrame = root.querySelector('[data-contact-frame]');
      oldFrame?.remove();
      const frame = document.createElement('iframe');
      const frameName = `${root.id}-contact-frame-${Date.now()}`;
      frame.name = frameName;
      frame.setAttribute('data-contact-frame', '');
      frame.setAttribute('aria-hidden', 'true');
      frame.hidden = true;

      let submitted = false;
      frame.addEventListener('load', () => {
        if (!submitted) {
          submitted = true;
          form.setAttribute('target', frameName);
          form.requestSubmit();
          return;
        }

        let responseUrl = '';
        try { responseUrl = frame.contentWindow.location.href; } catch (error) {}
        if (responseUrl.includes('/challenge') || responseUrl.includes('/errors')) {
          if (status) {
            status.textContent = 'A Shopify ainda exigiu uma verificação. Aguarde alguns minutos e tente novamente.';
            status.classList.add('is-error');
          }
          submitButton.disabled = false;
          return;
        }

        sessionStorage.setItem(storageKey, '1');
        if (status) status.textContent = 'Cadastro enviado. Abrindo preços...';
        formShell.classList.remove('is-open');
        formShell.classList.add('is-closing');
        window.setTimeout(() => {
          formShell.hidden = true;
          unlockCatalog();
          window.setTimeout(() => catalog?.scrollIntoView({ behavior: 'smooth', block: 'start' }), 180);
        }, 520);
      });
      root.appendChild(frame);
    });
    })();
  </script>
  
  {% style %}
    #{{ section_id }} { --ink:#17110f; --blue:#ff6633; --cyan:#ff9a78; --paper:#fff7f3; --muted:#6c5d57; --line:#efdeda; background:var(--paper); color:var(--ink); font-family:'Manrope', Arial, Helvetica, sans-serif; overflow:hidden; }
    #{{ section_id }} * { box-sizing:border-box; }
    #{{ section_id }} [hidden] { display:none !important; }
    #{{ section_id }} .cnpj-validator-fields,
