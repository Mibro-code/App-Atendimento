  {% schema %}
  {
    "name": "LP Varejo Mibro Final",
    "tag": "section",
    "class": "section-lp-mibro",
    "settings": [
      { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "PARCERIA COMERCIAL MIBRO" },
      { "type": "textarea", "id": "heading", "label": "Headline", "default": "Mibro: uma das maiores marcas de tecnologia vestível agora disponível para o seu negócio." },
      { "type": "textarea", "id": "subheading", "label": "Subheadline", "default": "Torne-se parceiro comercial Mibro e leve ao seu público uma marca internacional de wearables, com portfólio completo para todos os perfis de consumidor." },
      { "type": "header", "content": "Tamanhos dos textos" },
      { "type": "range", "id": "heading_size", "min": 40, "max": 96, "step": 2, "unit": "px", "label": "Tamanho da headline", "default": 76 },
      { "type": "range", "id": "subheading_size", "min": 14, "max": 32, "step": 1, "unit": "px", "label": "Tamanho da subheadline", "default": 22 },
      { "type": "range", "id": "benefit_text_size", "min": 12, "max": 24, "step": 1, "unit": "px", "label": "Tamanho do texto dos cards", "default": 16 },
      { "type": "range", "id": "button_text_size", "min": 13, "max": 24, "step": 1, "unit": "px", "label": "Tamanho do texto dos botões", "default": 17 },
      { "type": "range", "id": "table_text_size", "min": 12, "max": 22, "step": 1, "unit": "px", "label": "Tamanho do texto da tabela", "default": 15 },
      { "type": "video", "id": "video", "label": "Vídeo enviado ao Shopify" },
      { "type": "video_url", "id": "video_url", "accept": ["youtube", "vimeo"], "label": "Ou URL do YouTube/Vimeo" },
      { "type": "text", "id": "cta_text", "label": "Texto do botão que abre o formulário", "default": "Quero ser parceiro Mibro" },
      { "type": "text", "id": "cta_note", "label": "Nota abaixo do botão", "default": "Fale com nossa equipe e conheça as condições comerciais." },
      { "type": "text", "id": "form_heading", "label": "Título do formulário", "default": "Preencha seus dados para acessar os preços" },
      { "type": "textarea", "id": "form_text", "label": "Texto do formulário", "default": "Nossa equipe receberá seu cadastro e o portfólio comercial será liberado após o envio." },
    { "type": "text", "id": "form_submit_text", "label": "Texto do botão de enviar formulário", "default": "Enviar cadastro e liberar preços" },
    { "type": "text", "id": "campaign_name", "label": "Identificação desta página/campanha", "default": "Atacado" },
      {
        "type": "select",
        "id": "cnpj_data_level",
        "label": "Dados buscados pelo CNPJ nesta página",
        "default": "complete",
        "options": [
          { "value": "verify", "label": "Somente verificar o CNPJ" },
          { "value": "essential", "label": "Dados essenciais" },
          { "value": "complete", "label": "Todos os dados" }
        ]
      },      { "type": "checkbox", "id": "show_pricing_table", "label": "Exibir tabela de preços", "default": true },
      { "type": "text", "id": "products_heading", "label": "Título do portfólio", "default": "Preços por quantidade" },
      { "type": "header", "content": "Links dos produtos na tabela" },
      { "type": "url", "id": "link_c4", "label": "Link — Mibro C4" },
      { "type": "url", "id": "link_a3", "label": "Link — Mibro A3" },
      { "type": "url", "id": "link_lite_3", "label": "Link — Mibro Lite 3" },
      { "type": "url", "id": "link_lite_3_pro", "label": "Link — Mibro Lite 3 Pro" },
      { "type": "url", "id": "link_gs_pro", "label": "Link — Mibro GS Pro" },
      { "type": "url", "id": "link_gs_pro_2", "label": "Link — Mibro GS Pro 2" },
      { "type": "url", "id": "link_gs_active", "label": "Link — Mibro GS Active" },
      { "type": "url", "id": "link_gs_active_2", "label": "Link — Mibro GS Active 2" },
      { "type": "url", "id": "link_gs_explorer", "label": "Link — Mibro GS Explorer" },
      { "type": "text", "id": "final_heading", "label": "Chamada final", "default": "Leve uma marca global de wearables para o seu negócio." },
      { "type": "header", "content": "Botão final separado" },
      { "type": "text", "id": "final_cta_text", "label": "Texto do botão final", "default": "Falar com a equipe Mibro" },
      { "type": "url", "id": "final_cta_link", "label": "Link do botão final" },
      { "type": "checkbox", "id": "final_cta_new_tab", "label": "Abrir link em nova aba", "default": true }
    ],
    "blocks": [
      {
        "type": "benefit", "name": "Benefício", "limit": 6,
        "settings": [
          { "type": "image_picker", "id": "image", "label": "Imagem ou ícone" },
          { "type": "text", "id": "icon", "label": "Ícone em emoji (opcional)", "info": "Use, por exemplo: 🌎, ⌚, 🛠️ ou 🤝. A imagem tem prioridade sobre o emoji." },
          { "type": "text", "id": "text", "label": "Texto" }
        ]
      },
      {
        "type": "gallery", "name": "Imagem da faixa", "limit": 8,
        "settings": [
          { "type": "image_picker", "id": "image", "label": "Imagem" },
          { "type": "text", "id": "alt", "label": "Descrição da imagem", "default": "Wearable Mibro" }
        ]
      }
    ],
    "presets": [{
      "name": "LP Varejo Mibro Final",
      "blocks": [
        { "type": "benefit", "settings": { "text": "Marca global, presente em centenas de mercados, com respaldo de parceiros de peso" } },
        { "type": "benefit", "settings": { "text": "Portfólio completo: linhas esportivas, lifestyle, essencial e áudio" } },
        { "type": "benefit", "settings": { "text": "Suporte técnico e comercial para sua equipe de vendas" } },
        { "type": "benefit", "settings": { "text": "Condições comerciais para parceiros estratégicos" } }
      ]
    }]
  }
  {% endschema %}
