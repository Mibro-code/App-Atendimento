NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/app_whats?schema=public
SESSION_SECRET=CHAVE_ALEATORIA_COM_PELO_MENOS_32_CARACTERES
VERIFY_TOKEN=TOKEN_DE_VERIFICACAO_DO_WEBHOOK
WHATSAPP_TOKEN=TOKEN_DA_WHATSAPP_CLOUD_API
PHONE_NUMBER_ID=ID_DO_NUMERO_META
WHATSAPP_BUSINESS_ACCOUNT_ID=ID_DA_CONTA_WHATSAPP_BUSINESS
GRAPH_VERSION=vXX.X
META_APP_SECRET=APP_SECRET_DA_META
INTEGRATION_API_SECRET=CHAVE_ALEATORIA_COM_PELO_MENOS_32_CARACTERES

# Cofre de credenciais de IA (opcional). Sem esta chave, o app inicia e o
# motor local continua funcionando, mas o painel não salva credenciais.
AI_SECRETS_ENCRYPTION_KEY=CHAVE_DE_32_BYTES_EM_HEX_OU_BASE64
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_TIMEOUT_MS=8000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=8000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=8000

# Web Push (opcional). Sem essas duas, notificações com o app fechado ficam desativadas sem quebrar o app.
VAPID_PUBLIC_KEY=CHAVE_PUBLICA_VAPID
VAPID_PRIVATE_KEY=CHAVE_PRIVADA_VAPID
VAPID_SUBJECT=mailto:suporte@seudominio.com
