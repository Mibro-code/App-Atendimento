PORT=3000
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/app_whats?schema=public"
WHATSAPP_TOKEN=
META_APP_SECRET=
PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
VERIFY_TOKEN=
GRAPH_VERSION=vXX.X
SESSION_SECRET=gere-uma-chave-aleatoria-longa
INTEGRATION_API_SECRET=gere-outra-chave-aleatoria-longa
NODE_ENV=development

# Web Push (notificações PWA com app fechado). Gere o par com: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY é exposta ao navegador (não é segredo); VAPID_PRIVATE_KEY nunca deve sair do servidor.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@seudominio.com

# Motor de IA / Fallback externo (opcional). Sem nenhuma credencial
# configurada (nem aqui, nem pelo painel), o Bot continua funcionando
# normalmente só com o motor local. Escolhido por Bot na tela de
# configuração ("Provider de IA externa" + modelo); só é chamado se "IA
# externa como fallback" estiver ligado E a confiança local ficar abaixo do
# limiar configurado.
#
# RECOMENDADO: cadastre/troque as chaves de GEMINI/ANTHROPIC/OPENAI direto
# pelo painel (aba "Chaves de IA" em /bots, só Admin) — nunca precisa editar
# env na VPS depois disso. As variáveis abaixo continuam funcionando como
# compatibilidade (usadas só quando não houver chave salva pelo painel para
# aquele provider).
AI_SECRETS_ENCRYPTION_KEY=gere-uma-chave-de-32-bytes-hex-ou-base64
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_TIMEOUT_MS=8000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=8000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=8000
