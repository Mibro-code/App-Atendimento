PORT=3000
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/app_whats?schema=public"
WHATSAPP_TOKEN=
META_APP_SECRET=
PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
VERIFY_TOKEN=
GRAPH_VERSION=vXX.X
SESSION_SECRET=gere-uma-chave-aleatoria-longa
INTEGRATION_API_SECRET=gere-outra-chave-aleatoria-longa
NODE_ENV=development

# Web Push (notificações PWA com app fechado). Gere o par com: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY é exposta ao navegador (não é segredo); VAPID_PRIVATE_KEY nunca deve sair do servidor.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@seudominio.com

# Motor de IA / Fallback externo (opcional). Sem nenhuma chave configurada, o
# Bot continua funcionando normalmente só com o motor local — nenhum destes
# providers é obrigatório. Escolhido por Bot na tela de configuração
# ("Provider de IA externa"); só é chamado se "IA externa como fallback"
# estiver ligado E a confiança local ficar abaixo do limiar configurado.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
