generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Channel {
  META
  ZENVIA
}

enum ConversationStatus {
  NOVO
  EM_ATENDIMENTO
  AGUARDANDO_RESPOSTA
  BOT
  FINALIZADO
}

enum MessageDirection {
  RECEBIDA
  ENVIADA
}

enum MessageStatus {
  RECEBIDA
  PENDENTE
  ENVIADA
  ENTREGUE
  LIDA
  FALHOU
}

enum UserRole {
  ADMIN
  SUPERVISOR
  ATENDENTE
  BOT
}

model Contact {
  id            String         @id @default(cuid())
  channel       Channel        @default(META)
  externalId    String
  phone         String
  name          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
  notes         ContactNote[]

  @@unique([channel, externalId])
  @@index([phone])
}

model ContactNote {
  id        String   @id @default(cuid())
  contactId String
  authorId  String?
  content   String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  author    User?    @relation("ContactNotes", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([contactId, createdAt])
  @@index([authorId])
}

model Conversation {
  id             String                 @id @default(cuid())
  contactId      String
  channel        Channel                @default(META)
  categoryId     String?
  assignedUserId String?
  status         ConversationStatus     @default(NOVO)
  unreadCount    Int                    @default(0)
  lastMessageAt  DateTime?
  finalizedAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  contact        Contact                @relation(fields: [contactId], references: [id], onDelete: Cascade)
  category       Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  assignedUser   User?                  @relation("AssignedConversations", fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages       Message[]
  activities     ConversationActivity[]
  pins           ConversationPin[]

  @@unique([contactId, channel])
  @@index([status, lastMessageAt])
  @@index([categoryId, lastMessageAt])
  @@index([assignedUserId])
}

model Message {
  id              String           @id @default(cuid())
  conversationId  String
  externalId      String?          @unique
  channel         Channel          @default(META)
  direction       MessageDirection
  status          MessageStatus
  type            String
  text            String?
  mediaStorageKey String?
  mediaMimeType   String?
  mediaFileName   String?
  mediaSize       Int?
  occurredAt      DateTime
  sentByUserId    String?
  rawPayload      Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  conversation    Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sentByUser      User?            @relation("SentMessages", fields: [sentByUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, occurredAt])
  @@index([sentByUserId])
}

model User {
  id                         String                 @id @default(cuid())
  name                       String
  email                      String                 @unique
  passwordHash               String?
  role                       UserRole               @default(ATENDENTE)
  active                     Boolean                @default(true)
  sessionVersion             Int                    @default(0)
  canViewUncategorized       Boolean                @default(false)
  canManageCategories        Boolean                @default(false)
  canTransferConversations   Boolean                @default(false)
  canViewTeamActivity        Boolean                @default(false)
  canViewConversationHistory Boolean                @default(false)
  canViewPreviousMessages    Boolean                @default(false)
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  assignedConversations      Conversation[]         @relation("AssignedConversations")
  sentMessages               Message[]              @relation("SentMessages")
  contactNotes               ContactNote[]          @relation("ContactNotes")
  categoryAccess             UserCategoryAccess[]
  conversationPins           ConversationPin[]
  conversationActivities     ConversationActivity[] @relation("ConversationActivityActor")
  auditLogs                  AuditLog[]              @relation("AuditLogActor")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorName   String?
  actorEmail  String?
  action      String
  entityType  String
  entityId    String?
  summary     String
  details     Json?
  createdAt   DateTime @default(now())
  actorUser   User?    @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
}

model ConversationPin {
  userId         String
  conversationId String
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([userId, conversationId])
  @@index([conversationId])
}

model ConversationActivity {
  id             String       @id @default(cuid())
  conversationId String
  actorUserId    String?
  action         String
  details        Json?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actorUser      User?        @relation("ConversationActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([actorUserId])
}

model Category {
  id            String               @id @default(cuid())
  parentId      String?
  code          String               @unique
  name          String
  color         String?
  active        Boolean              @default(true)
  displayOrder  Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  conversations Conversation[]
  parent        Category?            @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      Category[]           @relation("CategoryHierarchy")
  userAccess    UserCategoryAccess[]

  @@index([parentId, displayOrder])
}

model UserCategoryAccess {
  userId     String
  categoryId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@index([categoryId])
}
