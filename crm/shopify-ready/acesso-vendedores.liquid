<script>
  (function () {
    const root = document.getElementById({{ section_id | json }});

    if (!root) {
      return;
    }

    const form = root.querySelector('.mibro-seller-form');
    const passwordInput = root.querySelector('.mibro-seller-password');
    const togglePassword = root.querySelector(
      '.mibro-seller-toggle-password'
    );
    const submitButton = root.querySelector('.mibro-seller-submit');
    const message = root.querySelector('.mibro-seller-message');

    const configuredPassword =
      {{ section.settings.fixed_password | json }};

    const configuredDestination =
      {{ destination_url | json }};

    const accessKey = 'mibro_seller_access_v1';
    const accessValue = 'authorized';

    if (root.dataset.hideHeaderFooter === 'true') {
      document.body.classList.add('mibro-seller-clean-page');
    }

    function getDestinationUrl() {
      const parameters = new URLSearchParams(
        window.location.search
      );

      const requestedPage = parameters.get('next');

      if (
        requestedPage &&
        requestedPage.startsWith('/') &&
        !requestedPage.startsWith('//')
      ) {
        return requestedPage;
      }

      return configuredDestination;
    }

    function hasActiveAccess() {
      try {
        return (
          sessionStorage.getItem(accessKey) === accessValue
        );
      } catch (error) {
        return false;
      }
    }

    function saveAccess() {
      try {
        sessionStorage.setItem(accessKey, accessValue);
        return true;
      } catch (error) {
        return false;
      }
    }

    function normalizePassword(password) {
      {% if section.settings.case_sensitive %}
        return password;
      {% else %}
        return password.toLocaleLowerCase('pt-BR');
      {% endif %}
    }

    function showError(text) {
      message.textContent = text;
      message.classList.remove('is-success');

      passwordInput.classList.add('has-error');

      root.classList.remove('has-login-error');

      void root.offsetWidth;

      root.classList.add('has-login-error');

      passwordInput.focus();
      passwordInput.select();
    }

    function clearMessage() {
      message.textContent = '';
      message.classList.remove('is-success');
      passwordInput.classList.remove('has-error');
      root.classList.remove('has-login-error');
    }

    function redirectToDestination() {
      const destination = getDestinationUrl();

      if (!destination) {
        showError(
          'A página de consulta ainda não foi configurada.'
        );

        submitButton.disabled = false;
        submitButton.classList.remove('is-loading');

        return;
      }

      window.location.replace(destination);
    }

    /*
      Se o vendedor já foi autorizado nesta aba,
      ele não precisa digitar a senha novamente.
    */
    if (hasActiveAccess()) {
      redirectToDestination();
      return;
    }

    togglePassword.addEventListener('click', function () {
      const passwordIsVisible =
        passwordInput.type === 'text';

      passwordInput.type =
        passwordIsVisible ? 'password' : 'text';

      togglePassword.classList.toggle(
        'is-visible',
        !passwordIsVisible
      );

      togglePassword.setAttribute(
        'aria-label',
        passwordIsVisible
          ? 'Mostrar senha'
          : 'Ocultar senha'
      );

      passwordInput.focus();
    });

    passwordInput.addEventListener('input', clearMessage);

    form.addEventListener('submit', function (event) {
      event.preventDefault();

      clearMessage();

      const enteredPassword =
        passwordInput.value.trim();

      if (!enteredPassword) {
        showError('Digite a senha para continuar.');
        return;
      }

      if (!configuredPassword) {
        showError(
          'A senha de acesso ainda não foi configurada.'
        );
        return;
      }

      const normalizedEnteredPassword =
        normalizePassword(enteredPassword);

      const normalizedConfiguredPassword =
        normalizePassword(configuredPassword.trim());

      if (
        normalizedEnteredPassword !==
        normalizedConfiguredPassword
      ) {
        showError(
          'Senha incorreta. Verifique e tente novamente.'
        );

        return;
      }

      submitButton.disabled = true;
      submitButton.classList.add('is-loading');

      message.textContent = 'Acesso autorizado.';
      message.classList.add('is-success');

      saveAccess();

      window.setTimeout(function () {
        redirectToDestination();
      }, 550);
    });
  })();
</script>

